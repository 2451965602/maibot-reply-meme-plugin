{
  "manifest_version": 2,
  "id": "local.maibot-reply-meme-plugin",
  "version": "1.0.0",
  "name": "MaiBot Reply Meme Plugin",
  "description": "Send a relevant aigengtu.com meme to the invoking QQ chat.",
  "author": {"name": "2451965602"},
  "license": "MIT",
  "plugin_type": "media",
  "host_application": {"min_version": "1.3.0", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.5.0", "max_version": "2.99.99"},
  "dependencies": [{"type": "python_package", "name": "aiohttp", "version_spec": ">=3.9,<4"}],
  "capabilities": ["send.image", "config.get"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
