{
  "manifest_version": 2,
  "id": "fjyxyz.reply-meme",
  "version": "1.0.4",
  "name": "回复配图·梗鲸",
  "description": "从梗鲸图库筛选贴切表情包，并只发送到当前 QQ 聊天流。",
  "author": {"name": "fjyxyz", "url": "https://github.com/2451965602"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/2451965602/maibot-reply-meme-plugin",
    "homepage": "https://github.com/2451965602/maibot-reply-meme-plugin",
    "documentation": "https://github.com/2451965602/maibot-reply-meme-plugin#readme",
    "issues": "https://github.com/2451965602/maibot-reply-meme-plugin/issues"
  },
  "plugin_type": "media",
  "host_application": {"min_version": "1.3.0", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.5.0", "max_version": "2.16.99"},
  "dependencies": [{"type": "python_package", "name": "aiohttp", "version_spec": ">=3.9,<4"}],
  "capabilities": ["send.image"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
